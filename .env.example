# OpenRouter (LLM source discovery)
OPENROUTER_API_KEY=

# Resend (transactional email)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Test sender only delivers to the Resend account owner until a domain is verified.
RESEND_FROM=onboarding@resend.dev
# Account-owner address used as the recipient override while the domain is unverified.
# Unset this once a verified sending domain is configured.
RESEND_TO=

# Protects the cron endpoint: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
