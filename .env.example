# OpenRouter (LLM source discovery)
OPENROUTER_API_KEY=

# Resend (transactional email)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Test sender only delivers to the Resend account owner until a domain is verified.
RESEND_FROM=onboarding@resend.dev
# Account-owner address used as the recipient override while the domain is unverified.
# Unset this once a verified sending domain is configured.
RESEND_TO=

# Protects the cron endpoint: Authorization: Bearer <CRON_SECRET>
# Required in production; the cron endpoint returns 503 if unset there.
CRON_SECRET=

# App-level login gate
# Shared password required to sign in. Required in production.
APP_PASSWORD=
# Secret used to sign session cookies. Falls back to APP_PASSWORD when unset.
# Set a long random value in production (e.g. `openssl rand -hex 32`) so
# sessions can be rotated independently of the login password.
AUTH_SECRET=
